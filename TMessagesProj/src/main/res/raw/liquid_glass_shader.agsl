uniform shader img;
uniform float2 resolution;
uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_index;
uniform float refract_intensity;
uniform float4 foreground_color_premultiplied;
uniform float specular_strength;
uniform float dispersion_strength;
uniform float frost_amount;
uniform float fresnel_strength;
uniform float reflection_strength;
uniform float grain_amount;

float sdfRect(float2 p, float4 r) {
  r.xy = (p.x > 0.0) ? r.xy : r.zw;
  r.x = (p.y > 0.0) ? r.x : r.y;
  float2 q = abs(p) - size + r.x;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r.x;
}

half4 overPremul(half4 src, half4 dst) {
  return half4(src.rgb + dst.rgb * (1.0 - src.a),
      src.a + dst.a * (1.0 - src.a));
}

float2 clampToScreen(float2 uv) {
  return clamp(uv, float2(0.5), max(resolution - float2(0.5), float2(0.5)));
}

float glassNoise(float2 p) {
  return fract(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
}

half4 frostedBackdrop(float2 uv) {
  float amount = clamp(frost_amount, 0.0, 1.0);
  if (amount <= 0.001) return img.eval(uv);

  float radiusPx = clamp(amount * min(size.x, size.y) * 0.095, 1.0, 26.0);
  float2 x = float2(radiusPx, 0.0);
  float2 y = float2(0.0, radiusPx);
  float2 d = radiusPx * 0.7071;
  half4 result = img.eval(uv) * 0.20;
  result += img.eval(clampToScreen(uv + x)) * 0.12;
  result += img.eval(clampToScreen(uv - x)) * 0.12;
  result += img.eval(clampToScreen(uv + y)) * 0.12;
  result += img.eval(clampToScreen(uv - y)) * 0.12;
  result += img.eval(clampToScreen(uv + float2(d, d))) * 0.08;
  result += img.eval(clampToScreen(uv + float2(-d, d))) * 0.08;
  result += img.eval(clampToScreen(uv + float2(d, -d))) * 0.08;
  result += img.eval(clampToScreen(uv - float2(d, d))) * 0.08;
  return result;
}

half4 main(float2 fragCoord) {
  float2 p = fragCoord - center;
  float sd = sdfRect(p, radius);
  float edgeWidth = max(thickness, 0.75);

  float2 gradient = float2(
      sdfRect(p + float2(1.0, 0.0), radius) - sd,
      sdfRect(p + float2(0.0, 1.0), radius) - sd);
  gradient = normalize(length(gradient) > 0.001 ? gradient : float2(1.0, 0.0));

  float edge = 1.0 - smoothstep(-edgeWidth * 1.65, 0.0, sd);
  float bevel = 1.0 - smoothstep(-edgeWidth, edgeWidth * 0.18, sd);
  float3 normal = normalize(float3(gradient * bevel, sqrt(max(1.0 - bevel * bevel, 0.0))));

  float3 incident = float3(0.0, 0.0, -1.0);
  float3 refracted = refract(incident, normal, 1.0 / max(refract_index, 1.01));
  float innerDepth = max(-sd, 0.0);
  float opticalDistance = min((innerDepth * 0.16 + edgeWidth * (0.72 + 0.65 * bevel))
      / max(abs(refracted.z), 0.30), edgeWidth * 3.6);
  float2 refractedUv = clampToScreen(fragCoord + refracted.xy * opticalDistance
      * clamp(refract_intensity, 0.0, 1.6));
  half4 background = frostedBackdrop(refractedUv);

  float dispersion = edge * clamp(dispersion_strength, 0.0, 2.0) * 0.75;
  if (dispersion > 0.01) {
    float2 direction = normalize(refractedUv - fragCoord + gradient * 0.001);
    half red = img.eval(clampToScreen(refractedUv + direction * dispersion)).r;
    half blue = img.eval(clampToScreen(refractedUv - direction * dispersion)).b;
    background.rgb = half3(red, background.g, blue);
  }

  float bodyAlpha = clamp(0.085 + clamp(frost_amount, 0.0, 1.0) * 0.13, 0.085, 0.23);
  half4 bodyTint = half4(foreground_color_premultiplied.rgb * 0.32
      + half3(0.94, 0.975, 1.0) * bodyAlpha, bodyAlpha);
  half4 surface = overPremul(bodyTint, background);

  float fresnel = pow(clamp(1.0 - abs(normal.z), 0.0, 1.0), 1.18)
      * clamp(fresnel_strength, 0.0, 2.0);
  float3 lightDirection = normalize(float3(-0.52, -0.66, 0.56));
  float directLight = pow(max(dot(normal, lightDirection), 0.0), 9.0)
      * clamp(specular_strength, 0.0, 2.5);

  float topLeft = 1.0 - smoothstep(-size.y * 0.40, size.y * 0.58, p.y);
  topLeft *= 1.0 - smoothstep(-size.x * 0.38, size.x * 0.62, p.x);
  float bottomRight = smoothstep(-size.x * 0.15, size.x * 0.72, p.x)
      * smoothstep(-size.y * 0.12, size.y * 0.72, p.y);

  float innerLight = (1.0 - smoothstep(-min(size.x, size.y) * 0.42,
      -edgeWidth * 0.8, sd)) * topLeft;
  float upperRim = edge * (0.12 + fresnel * 0.42 + directLight * 0.52)
      + innerLight * 0.055;
  float lowerRim = edge * (0.07 + bottomRight * 0.18);

  float sheenLine = p.x / max(size.x, 1.0) + p.y / max(size.y, 1.0) * 0.74;
  float sheen = (1.0 - smoothstep(0.0, 0.18, abs(sheenLine + 0.33)))
      * topLeft * (0.035 + directLight * 0.10);

  surface.rgb *= half3(1.0 - lowerRim);
  surface.rgb = clamp(surface.rgb + half3(upperRim + sheen), 0.0, 1.0);

  float grain = (glassNoise(fragCoord + center * 0.37) - 0.5)
      * clamp(grain_amount, 0.0, 1.0) * 0.018;
  surface.rgb = clamp(surface.rgb + half3(grain), 0.0, 1.0);
  return surface;
}
