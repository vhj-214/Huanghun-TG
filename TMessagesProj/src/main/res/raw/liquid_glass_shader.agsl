uniform shader img;
uniform float2 resolution;
uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_index;
uniform float refract_intensity;
uniform float4 foreground_color_premultiplied;
uniform float specular_strength;
uniform float dispersion_strength;
uniform float frost_amount;
uniform float fresnel_strength;
uniform float reflection_strength;
uniform float grain_amount;

float sdfRect(float2 p, float4 r) {
  r.xy = (p.x > 0.0) ? r.xy : r.zw;
  r.x = (p.y > 0.0) ? r.x : r.y;
  float2 q = abs(p) - size + r.x;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r.x;
}

half4 srcOver(half4 src, half4 dst) {
  return half4(src.rgb + dst.rgb * (1.0 - src.a),
      src.a + (1.0 - src.a) * dst.a);
}

float2 clampToScreen(float2 uv) {
  return clamp(uv, float2(0.5), max(resolution - float2(0.5), float2(0.5)));
}

float glassNoise(float2 p) {
  return fract(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
}

half4 evalFrosted(float2 uv) {
  float amount = clamp(frost_amount, 0.0, 1.0);
  if (amount <= 0.001) return img.eval(uv);
  float radiusPx = amount * max(size.x, size.y) * 0.075;
  // Five taps are enough for a soft frosted body. The previous 13-tap kernel
  // multiplied the cost of every visible glass surface and could stutter when
  // the chat list, input bar and emoji panel were visible together.
  half4 result = img.eval(uv) * 0.42;
  result += img.eval(clampToScreen(uv + float2(radiusPx, 0.0))) * 0.145;
  result += img.eval(clampToScreen(uv - float2(radiusPx, 0.0))) * 0.145;
  result += img.eval(clampToScreen(uv + float2(0.0, radiusPx))) * 0.145;
  result += img.eval(clampToScreen(uv - float2(0.0, radiusPx))) * 0.145;
  return result;
}

half4 main(float2 fragCoord) {
  float2 p = fragCoord - center;
  float sd = sdfRect(p, radius);
  float edgeWidth = max(thickness, 0.5);
  float2 normalDelta = float2(
      sdfRect(p + float2(1.0, 0.0), radius) - sd,
      sdfRect(p + float2(0.0, 1.0), radius) - sd);
  float normalCos = clamp((edgeWidth + sd) / edgeWidth, 0.0, 1.0);
  float normalSin = sqrt(max(1.0 - normalCos * normalCos, 0.0));
  float3 normal = normalize(float3(normalDelta * normalCos, normalSin));
  float2 uv = fragCoord;

  if (sd < 0.0) {
    float3 refracted = refract(float3(0.0, 0.0, -1.0), normal,
        1.0 / max(refract_index, 1.01));
    float depth = sd < -edgeWidth ? edgeWidth
        : sqrt(max(sd * (-2.0 * edgeWidth - sd), 0.0));
    float opticalDistance = min((depth + 1.15 * edgeWidth)
        / max(abs(refracted.z), 0.24), 3.2 * edgeWidth);
    uv += refracted.xy * opticalDistance * clamp(refract_intensity, 0.0, 1.2);
  }
  uv = clampToScreen(uv);
  half4 background = evalFrosted(uv);

  float offsetLength = length(uv - fragCoord);
  float2 dispersionDirection = offsetLength > 0.001
      ? normalize(uv - fragCoord)
      : (length(normalDelta) > 0.001 ? normalize(normalDelta) : float2(1.0, 0.0));
  float edge = 1.0 - smoothstep(0.0, edgeWidth * 1.75, abs(sd));
  float dispersion = edge * 0.48 * clamp(dispersion_strength, 0.0, 2.0);
  // Chromatic separation is restricted to the bevel. Avoid two extra texture
  // reads in the body of every panel where they are visually imperceptible.
  if (edge > 0.01 && dispersion > 0.01) {
    half red = img.eval(clampToScreen(uv + dispersionDirection * dispersion)).r;
    half blue = img.eval(clampToScreen(uv - dispersionDirection * dispersion)).b;
    background.rgb = half3(red, background.g, blue);
  }

  half4 surface = srcOver(half4(foreground_color_premultiplied), background);
  float specular = clamp(specular_strength, 0.0, 2.0);
  float fresnel = pow(clamp(1.0 - abs(normal.z), 0.0, 1.0), 1.35)
      * clamp(fresnel_strength, 0.0, 2.0);
  float3 lightDirection = normalize(float3(-0.48, -0.62, 0.62));
  float directLight = pow(max(dot(normal, lightDirection), 0.0), 12.0)
      * specular * clamp(reflection_strength, 0.0, 2.0);
  float topLeft = 1.0 - smoothstep(-size.y * 0.32, size.y * 0.56, p.y);
  topLeft *= 1.0 - smoothstep(-size.x * 0.28, size.x * 0.62, p.x);
  float bodyAlpha = clamp(0.018 + clamp(frost_amount, 0.0, 1.0) * 0.075, 0.0, 0.11);
  surface = srcOver(half4(0.96, 0.98, 1.0, bodyAlpha), surface);

  // Apple-style suspended rim: bright upper-left bevel, dark lower-right bevel,
  // and a broad moving sheen rather than a flat white overlay.
  float upperRim = edge * (0.10 + topLeft * 0.30 + fresnel * 0.22 + directLight * 0.24);
  float lowerRim = edge * (0.045 + (1.0 - topLeft) * 0.08);
  float sheenCoordinate = (p.x / max(size.x, 1.0))
      + (p.y / max(size.y, 1.0)) * 0.72;
  float sheen = (1.0 - smoothstep(0.02, 0.28, abs(sheenCoordinate + 0.38)))
      * topLeft * (0.028 + directLight * 0.08);
  float highlightAlpha = clamp(upperRim + sheen, 0.0,
      0.42 * max(specular, 0.35)) * clamp(reflection_strength, 0.0, 2.0);
  surface.rgb *= half3(1.0 - lowerRim);
  surface.rgb = clamp(surface.rgb + half3(highlightAlpha, highlightAlpha, highlightAlpha), 0.0, 1.0);

  float grain = (glassNoise(fragCoord + center * 0.37) - 0.5)
      * clamp(grain_amount, 0.0, 1.0) * 0.022;
  surface.rgb = clamp(surface.rgb + half3(grain, grain, grain), 0.0, 1.0);
  return surface;
}
