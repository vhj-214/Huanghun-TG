uniform shader img;

uniform float2 resolution;
uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_index;
uniform float refract_intensity;
uniform float4 foreground_color_premultiplied;

float sdfRect(float2 p, float4 r) {
  r.xy = (p.x > 0.0) ? r.xy : r.zw;
  r.x = (p.y > 0.0) ? r.x : r.y;
  float2 q = abs(p) - size + r.x;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r.x;
}

half4 srcOver(half4 src, half4 dst) {
  half3 outRGB = src.rgb + dst.rgb * (1.0 - src.a);
  half outA = src.a + (1.0 - src.a) * dst.a;
  return half4(outRGB, outA);
}

float2 clampToScreen(float2 uv) {
  float2 maximum = max(resolution - float2(0.5), float2(0.5));
  return clamp(uv, float2(0.5), maximum);
}

half4 main(float2 fragCoord) {
  float2 p = fragCoord - center;
  float sd = sdfRect(p, radius);
  float safeThickness = max(thickness, 0.5);
  float2 uv = fragCoord;
  float2 normalDelta = float2(
      sdfRect(p + float2(1.0, 0.0), radius) - sd,
      sdfRect(p + float2(0.0, 1.0), radius) - sd);
  float normalCos = clamp((safeThickness + sd) / safeThickness, 0.0, 1.0);
  float normalSin = sqrt(max(1.0 - normalCos * normalCos, 0.0));
  float3 normal = normalize(float3(normalDelta * normalCos, normalSin));
  float2 refractOffset = float2(0.0);

  if (sd < 0.0) {
    float3 refractVector = refract(float3(0.0, 0.0, -1.0), normal,
        1.0 / max(refract_index, 1.01));
    float h = sd < -safeThickness
        ? safeThickness
        : sqrt(max(sd * (-2.0 * safeThickness - sd), 0.0));
    float opticalDistance = min(
        (h + 1.35 * safeThickness) / max(abs(refractVector.z), 0.2),
        4.0 * safeThickness);
    refractOffset = refractVector.xy * opticalDistance
        * clamp(refract_intensity, 0.0, 1.2);
    uv += refractOffset;
  }

  uv = clampToScreen(uv);
  half4 background = img.eval(uv);

  // A tiny edge-only color split mimics real glass dispersion without washing
  // the wallpaper or text behind the panel into a blur.
  float offsetLength = length(refractOffset);
  float2 dispersionDirection = offsetLength > 0.001
      ? refractOffset / offsetLength
      : (length(normalDelta) > 0.001 ? normalize(normalDelta) : float2(1.0, 0.0));
  float inside = 1.0 - smoothstep(0.0, 1.0, sd);
  float edge = (1.0 - smoothstep(0.0, max(safeThickness * 1.65, 1.0), abs(sd))) * inside;
  float dispersion = edge * 0.42;
  half red = img.eval(clampToScreen(uv + dispersionDirection * dispersion)).r;
  half blue = img.eval(clampToScreen(uv - dispersionDirection * dispersion)).b;
  background.rgb = half3(red, background.g, blue);

  half4 surface = srcOver(half4(foreground_color_premultiplied), background);

  float topLight = 1.0 - smoothstep(-size.y * 0.22, size.y * 0.62, p.y);
  float leftLight = 1.0 - smoothstep(-size.x * 0.18, size.x * 0.58, p.x);
  float fresnel = pow(clamp(1.0 - abs(normal.z), 0.0, 1.0), 1.8);
  float3 lightDirection = normalize(float3(-0.36, -0.52, 0.78));
  float specular = pow(max(dot(normal, lightDirection), 0.0), 18.0);
  float rimAlpha = edge * (0.045 + 0.095 * topLight * leftLight + 0.13 * fresnel + 0.12 * specular);

  // Broad, low-opacity reflection gives a suspended glass look while leaving
  // fine wallpaper lines visible through the body of the material.
  float diagonal = 1.0 - smoothstep(0.12, 0.86,
      abs((p.x / max(size.x, 1.0)) + (p.y / max(size.y, 1.0)) * 0.72));
  float sheenAlpha = diagonal * topLight * inside * (0.018 + fresnel * 0.025);
  float highlightAlpha = clamp(rimAlpha + sheenAlpha, 0.0, 0.28);
  half4 reflection = half4(highlightAlpha, highlightAlpha, highlightAlpha, highlightAlpha);

  float lowerRim = edge * (1.0 - topLight) * (0.025 + 0.025 * fresnel);
  surface.rgb *= half3(1.0 - lowerRim);
  return srcOver(reflection, surface);
}
